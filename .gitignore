# ============================================================
# VANTAGE CTI - Git Ignore
# ============================================================

# Python virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Local environment variables / secrets
.env
.env.*
!.env.example

# Frontend dependencies
frontend/node_modules/
node_modules/

# Frontend build output
frontend/dist/
dist/

# Vite / frontend cache
.vite/
frontend/.vite/

# IDE / editor files
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary/local inventory files
frontend-current-files.txt